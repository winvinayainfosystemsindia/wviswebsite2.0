# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wvis_db?schema=public"

# Security & Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-length"
JWT_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins allowed)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:4173"

# File Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="25"
